{
  "name": "construction-management-platform",
  "version": "1.0.0",
  "scripts": {
    "dev": "webpack serve",
    "build": "node scripts/assert-prod-auth.mjs && webpack --mode production --progress",
    "build:low-mem": "bash scripts/build-low-mem.sh",
    "build:analyze": "node scripts/assert-prod-auth.mjs && webpack --mode production --progress --analyze",
    "build:stats": "webpack --mode production --json > dist/stats.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "check:nav-routes": "node scripts/check-nav-routes.mjs",
    "check:fa-icons": "node scripts/check-fa-icons.mjs",
    "deploy:site": "bash scripts/deploy-site.sh",
    "deploy:rollback": "bash scripts/deploy-rollback.sh",
    "deploy:agent": "node scripts/deploy-agent.mjs",
    "deploy:agent:init": "sudo bash scripts/init-deploy-agent.sh",
    "deploy:functions": "bash scripts/deploy-edge-functions.sh",
    "deploy:function:contract-document-convert": "bash scripts/deploy-edge-contract-document-convert.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:cost-invoice-mouse": "node scripts/e2e-cost-invoice-mouse-test.mjs",
    "test:e2e:project-management": "node scripts/e2e-project-management-test.mjs",
    "test:e2e:contract-management": "node scripts/e2e-contract-management-test.mjs",
    "test:e2e:all": "npm run test:e2e:cost-invoice-mouse && npm run test:e2e:project-management && npm run test:e2e:contract-management",
    "clean": "rm -rf dist",
    "prune:root-bundles": "node scripts/prune-stale-root-bundles.mjs",
    "gen:types": "supabase gen types typescript --local > src/supabase/database.types.ts",
    "init:admin": "node scripts/init-admin.js"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tiptap/core": "^3.23.2",
    "@tiptap/extension-image": "^3.23.2",
    "@tiptap/extension-link": "^3.23.2",
    "@tiptap/extension-table": "^3.23.2",
    "@tiptap/extension-table-cell": "^3.23.2",
    "@tiptap/extension-table-header": "^3.23.2",
    "@tiptap/extension-table-row": "^3.23.2",
    "@tiptap/extension-text-align": "^3.23.2",
    "@tiptap/extension-underline": "^3.23.2",
    "@tiptap/pm": "^3.23.2",
    "@tiptap/react": "^3.23.2",
    "@tiptap/starter-kit": "^3.23.2",
    "date-fns": "^2.30.0",
    "docx": "^9.1.0",
    "docx-preview": "^0.3.7",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.16.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.294.0",
    "mammoth": "^1.12.0",
    "playwright-core": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.5",
    "@babel/preset-typescript": "^7.23.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "compression-webpack-plugin": "^10.0.0",
    "core-js": "^3.34.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "playwright": "^1.60.0",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "react-refresh": "^0.14.0",
    "style-loader": "^3.3.3",
    "supabase": "^2.22.12",
    "tailwindcss": "^3.3.5",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "webpack": "^5.107.2",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
