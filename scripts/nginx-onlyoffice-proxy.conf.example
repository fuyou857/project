# ONLYOFFICE Document Server · Nginx 反代示例
#
# 前提：`docker compose --profile onlyoffice up -d` 后，本机 127.0.0.1:8080 对应容器内 80（见仓库根 docker-compose.yml）。
# 推荐单独子域名（如 office.example.com）整块反代到文档服务器；子路径 /onlyoffice/ 需文档服务器与前端协同配置，排错成本高。
#
# 使用步骤：
# 1. 复制本文件片段到站点 server { } 中，替换 server_name、ssl_certificate 路径。
# 2. `nginx -t && nginx -s reload`
# 3. 前端 .env：`ONLYOFFICE_DOCUMENT_SERVER_URL=https://office.example.com`（与浏览器访问的协议/域名一致）
#
# 说明：合同里的 .docx 使用 Supabase 签名 URL 时，ONLYOFFICE 容器须能访问公网 HTTPS；一般无需额外配置。

# --- 示例子域 server 块（按需 include）---
# server {
#     listen 443 ssl http2;
#     server_name office.example.com;
#
#     ssl_certificate     /path/to/fullchain.pem;
#     ssl_certificate_key /path/to/privkey.pem;
#
#     client_max_body_size 100M;
#
#     location / {
#         proxy_pass http://127.0.0.1:8080/;
#         proxy_http_version 1.1;
#         proxy_set_header Upgrade $http_upgrade;
#         proxy_set_header Connection $connection_upgrade;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_read_timeout 300s;
#         proxy_send_timeout 300s;
#     }
# }
