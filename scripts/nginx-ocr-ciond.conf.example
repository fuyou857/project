# 宝塔 / Nginx：站点 ocr.ciond.com 反向代理示例
# 将本文件内容合并到站点配置，或 include 到 server { } 内。
# 注意：不要在 Nginx 再写 Access-Control-Allow-*（与 FastAPI 重复会导致浏览器 CORS 失败）。

server {
    listen 443 ssl http2;
    server_name ocr.ciond.com;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8810;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 发票 OCR 首次加载模型 + 识别常超过 60s，必须加大（否则 POST 502、GET /health 仍 200）
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        send_timeout 300s;
    }
}
