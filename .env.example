# Supabase Configuration（前端构建仅注入 URL + ANON，见 webpack.config.js）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 可选：不写则使用 supabase.functions.invoke 直连 SUPABASE_URL（推荐，避免反代丢 Authorization 导致 401）
# 若必须走同源反代，与 scripts/nginx-supabase-functions-snippet.conf 配套后再取消注释：
# SUPABASE_FUNCTIONS_URL=/supabase/functions/v1

# 仅用于 scripts/init-admin.js、CI 运维机 — 切勿打包进浏览器或提交真实密钥
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 初始化首个管理员（可选，仅在运行 node scripts/init-admin.js 时需要）
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_PASSWORD=
# INIT_ADMIN_USERNAME=admin

# ONLYOFFICE 文档服务器（合同预览「ONLYOFFICE编辑器」标签页加载 api.js 与嵌入编辑器；须与浏览器 HTTPS 同源或可访问）
# 示例：https://office.example.com（不要尾斜杠也可）
# ONLYOFFICE_DOCUMENT_SERVER_URL=
# 构建时（npm run build / dev）会同时：① 打入 bundle 的 process.env；② 写入 index.html 内 window.__CIOND_ONLYOFFICE_DOCUMENT_SERVER_URL__（见 template.html）。
# 免 webpack 重建：也可在生成后的 index 中、主 bundle 脚本之前手写：
# <script>window.__CIOND_ONLYOFFICE_DOCUMENT_SERVER_URL__='https://你的文档服务器'</script>
# 在线编辑保存回调：须指向已实现 ONLYOFFICE 协议的 HTTPS 地址（文档服务器会 POST JSON，无用户登录态）。
# 推荐部署本仓库 Edge Function `onlyoffice-callback` 后填写（不要带查询参数，前端会自动附加 generated_contract_id 或 template_file_version_id）：
# ONLYOFFICE_CALLBACK_URL=https://wlkrdylgojkhgfzvcagc.supabase.co/functions/v1/onlyoffice-callback
# 部署：bash scripts/deploy-edge-functions.sh onlyoffice-callback
# Dashboard → Edge Functions → onlyoffice-callback → Secrets：确认已有 SUPABASE_URL、SUPABASE_SERVICE_ROLE_KEY（与 contract-document-convert 相同即可）。
# supabase/config.toml 中已设置 [functions.onlyoffice-callback] verify_jwt = false（ONLYOFFICE 服务器请求不带 Supabase JWT）。
# 若仍使用 Nginx 仅返回 {"error":0} 的占位接口，编辑器可能看似可改但无法把内容持久化到 Storage。
# 也可用 window.__CIOND_ONLYOFFICE_CALLBACK_URL__ 注入，与 ONLYOFFICE_CALLBACK_URL 等价。
# ONLYOFFICE_CALLBACK_URL=
#
# 自建 ONLYOFFICE 容器（仓库根 docker-compose.yml，默认不拉取以省内存；需 ≥4GB 空闲内存较稳）：
#   docker compose --profile onlyoffice pull
#   docker compose --profile onlyoffice up -d
# 映射端口（宿主机:容器 80）：
# ONLYOFFICE_HOST_PORT=8080
# 与前端 OnlyOfficeEditor 一致：未传 JWT 时保持 false；若改为 true 须在编辑器配置中接入 JWT（当前前端未实现）。
# ONLYOFFICE_JWT_ENABLED=false
# ONLYOFFICE_JWT_SECRET=
# 验证：浏览器打开 http://localhost:8080/welcome/ （端口与 ONLYOFFICE_HOST_PORT 一致）；生产环境用 HTTPS 反代见 scripts/nginx-onlyoffice-proxy.conf.example

# Docker 构建 contract-convert：国内若拉 docker.io 超时，取消下一行注释（或换其它可用代理库）
# CONTRACT_CONVERT_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim-bookworm
# Debian apt 源主机（容器内 libreoffice 安装）；阿里云慢可换清华：
# DEBIAN_APT_HOST=mirrors.tuna.tsinghua.edu.cn

# 可选：自建 PaddleOCR 发票识别（invoice-ocr-service）。配置后成本发票上传优先 multipart 调该服务。
# 填「根」或「完整 POST」均可，二选一（勿同时重复配置为两个不同值）：
# INVOICE_OCR_SERVICE_URL=https://ocr.example.com
# INVOICE_OCR_SERVICE_URL=https://ocr.example.com/api/invoice/ocr
# 若团队习惯 NEXT_PUBLIC_ 前缀（仍由 Webpack 注入，非 Next.js 专属）：
# NEXT_PUBLIC_INVOICE_OCR_SERVICE_URL=https://ocr.example.com
#
# 若未配置上一行（浏览器直连 OCR 不可行）：在 Supabase Dashboard → Edge Functions → Secrets 为函数 invoice-ocr 设置
# INVOICE_OCR_UPSTREAM_URL=https://你的OCR服务域名/api/invoice/ocr
# （与 invoice-ocr-service 的 POST /api/invoice/ocr 一致；Edge 会先从 Storage 公网 URL 拉取文件再转发给上游。）
# 推荐：在「系统管理 → 高级运维配置 → API 密钥中心」维护 key_code=invoice_ocr_upstream（热更新，无需重启）。

# API 密钥中心（Edge Function api-key-ops）：AES 加密主密钥，至少 32 字符，仅配置在 Supabase Secrets，勿进前端 bundle
# SYSTEM_API_KEY_ENCRYPTION_SECRET=your_random_32_char_secret_here
# 部署：npm run deploy:functions -- api-key-ops
# 数据库：执行 migrations/20260516120000_system_api_keys.sql
